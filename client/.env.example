# Copy to client/.env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# URL of the deployed API project (no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:3002"

# Mapbox public token for the venue map (optional; the map shows a notice without it)
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Google OAuth client ID for "Continue with Google" (optional; the button is
# hidden without it). Add your site origins under "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
# Stripe secret key for card payments (optional; checkout returns
# "payments not configured" without it)
STRIPE_SECRET_KEY=""

# Copy to server/.env for local development. On Vercel, set these in
# Project Settings → Environment Variables (the Neon integration adds the
# database ones automatically).

# Neon Postgres (needs the PostGIS extension, which the first migration enables)
# Pooled connection, used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection, used by `prisma migrate`:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-with-a-long-random-string"

# Frontend origin(s) allowed to call this API, comma-separated
CLIENT_URL="http://localhost:3000"

# Vercel Blob token for venue photo uploads. Leave empty locally to store
# photos in ./uploads instead.
BLOB_READ_WRITE_TOKEN=""

# Google sign-in: OAuth "Web application" client ID from
# https://console.cloud.google.com/apis/credentials (same value as the
# client's NEXT_PUBLIC_GOOGLE_CLIENT_ID). Leave empty to disable.
GOOGLE_CLIENT_ID=""

# Password reset emails via Resend (https://resend.com). Leave empty locally:
# the reset link is printed to the server console instead.
RESEND_API_KEY=""
# Sender address on a domain verified in Resend
EMAIL_FROM="OccasionHub <no-reply@yourdomain.com>"

# Local port (ignored on Vercel)
PORT=3002

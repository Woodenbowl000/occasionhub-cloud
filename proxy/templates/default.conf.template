# Rendered at container start: ${CLIENT_UPSTREAM}, ${API_UPSTREAM} and
# ${NGINX_RESOLVER} are filled from the environment.

# Shared cache for immutable assets (Next.js build files, venue photos)
proxy_cache_path /tmp/nginx-cache levels=1:2 keys_zone=assets:10m
                 max_size=256m inactive=7d use_temp_path=off;

# Behind the AWS load balancer the original scheme arrives in
# X-Forwarded-Proto; locally there is no balancer, so fall back to $scheme.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # Re-resolve upstream names every 30 s: on AWS the internal load
    # balancer's IP addresses change over time.
    resolver ${NGINX_RESOLVER} valid=30s ipv6=off;
    set $client_upstream ${CLIENT_UPSTREAM};
    set $api_upstream    ${API_UPSTREAM};

    # Photo uploads (multer limit is 4 MB per file, several files per form)
    client_max_body_size 20m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/xml application/rss+xml image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # Load balancer health check: answered by Nginx itself
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # ---- Application tier (private): /backend/* -> API, prefix removed ----
    location /backend/ {
        rewrite ^/backend/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # Venue photos never change once uploaded (unique names): cache them here
    location /backend/uploads/ {
        rewrite ^/backend/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_cache assets;
        proxy_cache_valid 200 7d;
        proxy_cache_valid 404 1m;
        add_header X-Cache-Status $upstream_cache_status always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Next.js build assets are content-hashed: cache for a year
    location /_next/static/ {
        proxy_pass http://$client_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_cache assets;
        proxy_cache_valid 200 30d;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Cache-Status $upstream_cache_status always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ---- Web front end: everything else goes to Next.js ----
    location / {
        proxy_pass http://$client_upstream;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}

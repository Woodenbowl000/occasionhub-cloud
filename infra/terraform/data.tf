# ---------------------------------------------------------------------------
# Database tier: RDS PostgreSQL in the isolated db subnets
# ---------------------------------------------------------------------------

resource "random_password" "db" {
  length  = 32
  special = false # avoids URL-encoding surprises in connection strings
}

resource "aws_db_subnet_group" "main" {
  name       = "${var.project}-db-subnets"
  subnet_ids = aws_subnet.db[*].id
  tags       = { Name = "${var.project}-db-subnets" }
}

resource "aws_db_parameter_group" "main" {
  name   = "${var.project}-pg${var.db_engine_version}"
  family = "postgres${var.db_engine_version}"

  # Reject any unencrypted connection
  parameter {
    name  = "rds.force_ssl"
    value = "1"
  }

  # Log statements slower than 500 ms (shipped to CloudWatch Logs)
  parameter {
    name  = "log_min_duration_statement"
    value = "500"
  }
}

resource "aws_db_instance" "main" {
  identifier     = "${var.project}-db"
  engine         = "postgres"
  engine_version = var.db_engine_version
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_max_allocated_storage # 0 = storage auto scaling off
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result
  port     = 5432

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  parameter_group_name   = aws_db_parameter_group.main.name
  publicly_accessible    = false
  multi_az               = var.db_multi_az

  backup_retention_period         = var.db_backup_retention_days
  backup_window                   = "19:00-20:00" # 00:00-01:00 PKT
  maintenance_window              = "sun:20:00-sun:21:00"
  auto_minor_version_upgrade      = true
  enabled_cloudwatch_logs_exports = ["postgresql"]
  copy_tags_to_snapshot           = true

  # Coursework convenience: `terraform destroy` removes the database without
  # a final snapshot. Set deletion_protection = true for real production data.
  deletion_protection = false
  skip_final_snapshot = true
  apply_immediately   = true

  tags = { Name = "${var.project}-db" }

  # Create the log group (with retention) before RDS starts exporting to it
  depends_on = [aws_cloudwatch_log_group.rds]
}

# ---------------------------------------------------------------------------
# Secrets: generated by Terraform, stored in AWS Secrets Manager, read at
# container start-up by the instance role. Nothing secret is in the images,
# launch templates, user data or the GitHub repository.
# ---------------------------------------------------------------------------

resource "random_password" "jwt" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "db" {
  name                    = "${var.project}/db-credentials"
  description             = "RDS PostgreSQL connection details for the application tier"
  recovery_window_in_days = 0 # allow immediate re-creation after destroy (coursework)
}

resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id
  secret_string = jsonencode({
    username = var.db_username
    password = random_password.db.result
    host     = aws_db_instance.main.address
    port     = aws_db_instance.main.port
    dbname   = var.db_name
  })
}

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.project}/app-secrets"
  description             = "API secrets: JWT signing key and optional third-party keys"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({ for k, v in {
    JWT_SECRET        = random_password.jwt.result
    STRIPE_SECRET_KEY = var.stripe_secret_key
    GOOGLE_CLIENT_ID  = var.google_client_id
    RESEND_API_KEY    = var.resend_api_key
    EMAIL_FROM        = var.email_from
  } : k => v if v != "" })
}

resource "aws_secretsmanager_secret" "web" {
  name                    = "${var.project}/web-secrets"
  description             = "Front-end server secrets (Stripe checkout route)"
  recovery_window_in_days = 0
}

resource "aws_secretsmanager_secret_version" "web" {
  secret_id = aws_secretsmanager_secret.web.id
  secret_string = jsonencode({ for k, v in {
    STRIPE_SECRET_KEY = var.stripe_secret_key
  } : k => v if v != "" })
}

# ---------------------------------------------------------------------------
# Object storage: venue photos (private bucket, served through the API)
# ---------------------------------------------------------------------------

resource "aws_s3_bucket" "uploads" {
  bucket        = "${var.project}-uploads-${data.aws_caller_identity.current.account_id}"
  force_destroy = true # coursework: lets `terraform destroy` empty the bucket
  tags          = { Name = "${var.project}-uploads" }
}

resource "aws_s3_bucket_public_access_block" "uploads" {
  bucket                  = aws_s3_bucket.uploads.id
  block_public_acls       = true
  block_public_policy     = true
  ignore_public_acls      = true
  restrict_public_buckets = true
}

resource "aws_s3_bucket_ownership_controls" "uploads" {
  bucket = aws_s3_bucket.uploads.id
  rule {
    object_ownership = "BucketOwnerEnforced"
  }
}

resource "aws_s3_bucket_server_side_encryption_configuration" "uploads" {
  bucket = aws_s3_bucket.uploads.id
  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
  }
}

resource "aws_s3_bucket_versioning" "uploads" {
  bucket = aws_s3_bucket.uploads.id
  versioning_configuration {
    status = "Enabled" # recover photos deleted or overwritten by mistake
  }
}

resource "aws_s3_bucket_lifecycle_configuration" "uploads" {
  bucket = aws_s3_bucket.uploads.id

  rule {
    id     = "expire-old-versions"
    status = "Enabled"
    filter {}
    noncurrent_version_expiration {
      noncurrent_days = 30
    }
    abort_incomplete_multipart_upload {
      days_after_initiation = 7
    }
  }

  depends_on = [aws_s3_bucket_versioning.uploads]
}

resource "aws_s3_bucket_policy" "uploads_tls_only" {
  bucket = aws_s3_bucket.uploads.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Sid       = "DenyInsecureTransport"
      Effect    = "Deny"
      Principal = "*"
      Action    = "s3:*"
      Resource  = [aws_s3_bucket.uploads.arn, "${aws_s3_bucket.uploads.arn}/*"]
      Condition = { Bool = { "aws:SecureTransport" = "false" } }
    }]
  })

  depends_on = [aws_s3_bucket_public_access_block.uploads]
}
